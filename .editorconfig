root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.yml]
indent_size = 2

# Recorded example output is compared byte-for-byte by ExamplesReplayTest.
[examples/tests/fixtures/**]
trim_trailing_whitespace = false
